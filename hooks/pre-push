#!/usr/bin/env bash
# Local gate, mirrored in CI.
set -euo pipefail

echo "[pre-push] nix format check..."
nixfmt --check $(find . -name '*.nix' -not -path './.git/*')

echo "[pre-push] rust format check..."
cargo fmt --check

echo "[pre-push] clippy..."
cargo clippy --all-targets --all-features -- -D warnings

echo "[pre-push] tests..."
cargo test

echo "[pre-push] all checks passed."
