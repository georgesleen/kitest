use flake

# Worktrees under worktrees/ share the main checkout's build output.
export CARGO_TARGET_DIR="$(git rev-parse --path-format=absolute --git-common-dir)/../target"
# Configure the repository-wide commit template and retain its `##` headings.
git config --local commit.template .gitmessage
git config --local core.commentChar ";"


# Install repo-tracked git hooks into .git/hooks so they run automatically.
# Symlinks are relative to .git/hooks so they survive the repo being moved.
# In a worktree .git is a file, so link through the common git directory.
hooks_dir="$(git rev-parse --path-format=absolute --git-common-dir)/hooks"
for hook in hooks/*; do
  [ -e "$hook" ] || continue
  name=$(basename "$hook")
  target="$hooks_dir/$name"
  if [ ! -L "$target" ] || [ "$(readlink "$target")" != "../../$hook" ]; then
    ln -sf "../../$hook" "$target"
    echo "direnv: installed git hook: $name"
  fi
done
