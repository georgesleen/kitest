"""Type stubs for the kitest extension; keep in sync with src/lib.rs."""

from typing import Literal

class DcSupply:
    def __init__(self, node: str, volts: float) -> None: ...

class AcSupply:
    def __init__(self, node: str) -> None: ...
    def bias(self, bias: float) -> AcSupply: ...
    def magnitude(self, magnitude: float) -> AcSupply: ...

class Pulse:
    @staticmethod
    def step(low: float, high: float) -> Pulse: ...
    def delay(self, delay: float) -> Pulse: ...
    def rise(self, rise: float) -> Pulse: ...
    def fall(self, fall: float) -> Pulse: ...
    def width(self, width: float) -> Pulse: ...
    def period(self, period: float) -> Pulse: ...

class Sin:
    def __init__(self, offset: float, amplitude: float, freq: float) -> None: ...
    def delay(self, delay: float) -> Sin: ...

class TranSource:
    @staticmethod
    def pulse(node: str, pulse: Pulse) -> TranSource: ...
    @staticmethod
    def sin(node: str, sin: Sin) -> TranSource: ...

class Sweep:
    Dec: Sweep
    Oct: Sweep
    Lin: Sweep

class Ac:
    def __init__(
        self, sweep: Sweep, points: int, fstart: float, fstop: float
    ) -> None: ...

class Tran:
    def __init__(self, step: float, stop: float) -> None: ...
    def start(self, start: float) -> Tran: ...

class Tolerance:
    @staticmethod
    def abs(v: float) -> Tolerance: ...
    @staticmethod
    def percent(p: float) -> Tolerance: ...

class Voltage:
    def volts(self) -> float: ...
    def near(self, expected: float, tolerance: Tolerance) -> bool: ...

class Frequency:
    def hertz(self) -> float: ...
    def near(self, expected: float, tolerance: Tolerance) -> bool: ...

class Tone:
    def frequency(self) -> Frequency: ...
    def amplitude(self) -> Voltage: ...
    def samples_per_cycle(self) -> float: ...

class Signal:
    def time(self) -> list[float]: ...
    def values(self) -> list[float]: ...
    def settles_to(
        self, target: float, tolerance: Tolerance, window: float
    ) -> bool: ...
    def overshoot(self, target: float) -> float: ...
    def dominant_tone(self) -> Tone: ...

class Response:
    def frequency(self) -> list[float]: ...
    def values(self) -> list[complex]: ...
    def gain_db_at(self, frequency: float) -> float: ...
    def phase_deg_at(self, frequency: float) -> float: ...

class OperatingPoint:
    def node(self, node: str) -> Voltage: ...
    def nodes(self) -> list[str]: ...

class Transient:
    def node(self, node: str) -> Signal: ...
    def nodes(self) -> list[str]: ...

class Spectra:
    def node(self, node: str) -> Response: ...
    def nodes(self) -> list[str]: ...

class Ngspice:
    def __init__(self) -> None: ...
    def run_op(
        self, netlist: str, supplies: list[DcSupply]
    ) -> OperatingPoint: ...
    def run_ac(
        self, netlist: str, supplies: list[AcSupply], params: Ac
    ) -> Spectra: ...
    def run_tran(
        self, netlist: str, sources: list[TranSource], params: Tran
    ) -> Transient: ...

def version() -> str: ...

class Netlist:
    def text(self) -> str: ...
    def defaulted(self) -> list[str]: ...

class Probe:
    def name(self) -> str: ...
    def net(self) -> str: ...
    def expect(self) -> str | None: ...
    def reference(self) -> str: ...

class Config:
    @staticmethod
    def for_project(directory: str) -> Config: ...
    @staticmethod
    def load(path: str) -> Config: ...
    def supplies(self) -> dict[str, list[float]]: ...
    def model_libraries(self) -> list[str]: ...

class Rail:
    def net(self) -> str: ...
    def kind(self) -> Literal["driven", "source", "ground"]: ...
    def voltages(self) -> list[float]: ...
    def origin(self) -> Literal["declared", "inferred"] | None: ...
    def driven_by(self) -> list[str]: ...

class Corner:
    def voltages(self) -> list[tuple[str, float]]: ...
    def dc_supplies(self) -> list[DcSupply]: ...
    def tran_sources(self) -> list[TranSource]: ...
    def ac_supplies(self) -> list[AcSupply]: ...

class Power:
    def rails(self) -> list[Rail]: ...
    def corners(self) -> list[Corner]: ...

class Design:
    def rails(self) -> list[str]: ...
    def netlist(self, libraries: list[str] = ...) -> Netlist: ...
    def probes(self) -> list[Probe]: ...
    def probe(self, name: str) -> Probe: ...
    def power(self, supplies: dict[str, list[float]] = ...) -> Power: ...

def export_design(sch: str) -> Design: ...
